uniform float Brightness;
uniform sampler2D Material;
uniform bool ApplyTinting;
uniform vec4 TintColor;

bool passesAlphaFunc(float alpha);

void main()
{
  gl_FragColor = texture2D(Material, gl_TexCoord[0].st);

  // Discard fully-cutout pixels for alpha-tested (masked) materials -- this preview
  // relies purely on GL_BLEND otherwise, which some materials (e.g. a Quake 3 shader
  // stage with alphaFunc but no blendFunc) explicitly disable via Material::activate().
  if (!passesAlphaFunc(gl_FragColor.a))
  {
    discard;
  }

  gl_FragColor = vec4(vec3(Brightness / 2.0 * gl_FragColor), gl_FragColor.a);
  gl_FragColor = vec4(clamp(2.0 * gl_FragColor.rgb, 0.0, 1.0), gl_FragColor.a);

  if (ApplyTinting)
  {
    gl_FragColor = vec4(gl_FragColor.rgb * TintColor.rgb * TintColor.a, gl_FragColor.a);
    gl_FragColor = clamp(2.0 * gl_FragColor, 0.0, 1.0);
  }
}
