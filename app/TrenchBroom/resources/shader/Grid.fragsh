// Soft line coverage shared with the other grid shaders (see GridCommon.fragsh).
float gridLine(float coord, float coordWidth, float stripeSize, float isMajor);

/**
 * Given any size, finds the next smaller size that is a proper grid size.
 * Returns the input unmodified if it's already a grid size.
 */
float gridFloor(float size)
{
  return exp2(floor(log2(size)));
}

/**
 * Draws the grid lines on which the given coordinate is constant.
 *
 * Every line belongs to the coarsest grid it lies on: the major grid, the grid of half
 * the major grid size, of a quarter of it, and so on. The lines of a grid fade out when
 * they get too close to each other on screen, so the finest grid fades out first. Minor
 * grids fade out sooner than major grids.
 *
 * @param value the coordinate in world space
 * @param gridSize the actual size of the grid (e.g. 16, 32, 64, etc.)
 * @param minGridSize the smallest grid size at which major lines are fully visible; they
 * are invisible at half of it
 * @param minorGridSizeFactor the same for minor lines, as a multiple of minGridSize
 * @param lineWidth the line width, in world units
 *
 * @return opacity of the grid line to draw on this fragment, in [0..1]
 */
float gridLines(
  float value,
  float gridSize,
  float minGridSize,
  float minorGridSizeFactor,
  float lineWidth)
{
  // place a major line every 64 units; if the grid is larger, all of its lines are major
  float majorGridSize = max(64.0, gridSize);
  float minMinorGridSize = minorGridSizeFactor * minGridSize;

  // the finest grid that is at least partially visible
  float baseGridSize = max(gridSize, gridFloor(minMinorGridSize));
  if (baseGridSize >= majorGridSize)
  {
    baseGridSize = max(majorGridSize, gridFloor(minGridSize));
  }

  float coord = value / baseGridSize; // coordinate in grid-cell units

  // The base grid size may differ between neighbouring fragments, so fwidth(coord) would
  // pick up the jump in it.
  float coordWidth = fwidth(value) / baseGridSize;

  // Find the coarsest grid that the nearest line lies on. Beyond the size at which a
  // line is major and fully visible, coarser grids make no difference.
  float lineIndex = floor(coord + 0.5);
  float lineGridSize = baseGridSize;
  float maxLineGridSize = max(majorGridSize, minGridSize);
  for (int i = 0; i < 16; ++i)
  {
    if (lineGridSize >= maxLineGridSize || mod(lineIndex, 2.0) != 0.0)
    {
      break;
    }
    lineIndex *= 0.5;
    lineGridSize *= 2.0;
  }

  float isMajor = step(majorGridSize, lineGridSize);

  // fully visible at the minimal grid size for this line, invisible at half of it
  float minLineGridSize = mix(minMinorGridSize, minGridSize, isMajor);
  float fade = 1.0 - smoothstep(lineGridSize, 2.0 * lineGridSize, minLineGridSize);

  float stripeSize = 1.0 - lineWidth / baseGridSize;
  return fade * gridLine(coord, coordWidth, stripeSize, isMajor);
}

/**
 * Projects the given vector onto the axis plane in which the grid is drawn for a surface
 * with the given normal.
 */
vec2 gridPlane(vec3 v, vec3 normal)
{
  if (abs(normal.x) > abs(normal.y))
  {
    if (abs(normal.x) > abs(normal.z))
    {
      return v.yz;
    }
    else
    {
      return v.xy;
    }
  }
  else if (abs(normal.y) > abs(normal.z))
  {
    return v.xz;
  }
  else
  {
    return v.xy;
  }
}

/*
 * Computes the grid for the current fragment with the given parameters.
 *
 * @param coords the coordinates of the fragment in world space (same units as gridSize)
 * @param normal the normal vector of the fragment
 * @param gridSize the actual size of the grid (e.g. 16, 32, 64, etc.)
 * @param minGridSize the minimal grid size to render per world axis (to fade out smaller
 * grids to prevent moire etc.); see lineWidthFactor for which lines each component
 * applies to
 * @param minorGridSizeFactor how many times larger than minGridSize a minor grid must be
 * to render; values above 1 fade out the minor grids sooner than the major grids
 * @param lineWidthFactor a factor for the line width of the grid per world axis; each
 * component applies to the lines on which that coordinate is constant, e.g. the x
 * component applies to the lines x = n * gridSize
 *
 * @return opacity of the grid line to draw on this fragment, in [0..1]
 */
float grid(
  vec3 coords,
  vec3 normal,
  float gridSize,
  vec3 minGridSize,
  float minorGridSizeFactor,
  vec3 lineWidthFactor)
{
  vec2 lineWidth = (gridSize < 1.0 ? (1.0 / 32.0) : (gridSize < 4.0 ? 0.25 : 0.5))
                   * gridPlane(lineWidthFactor, normal);

  // magic number to make the grid fade sooner, preventing aliasing
  vec2 minGridSizeToRender = 2.0 * gridPlane(minGridSize, normal);

  vec2 baseCoords = gridPlane(coords, normal);
  return max(
    gridLines(
      baseCoords.x, gridSize, minGridSizeToRender.x, minorGridSizeFactor, lineWidth.x),
    gridLines(
      baseCoords.y, gridSize, minGridSizeToRender.y, minorGridSizeFactor, lineWidth.y));
}
