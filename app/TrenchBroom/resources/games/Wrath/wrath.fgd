//
// LIGHT ENTITY
//

@PointClass color(.65 .65 1) size(-8 -8 -8, 8 8 8) = light : "Non-displayed point light source. The -pointscale and -scale arguments to Q3Map2 affect the brightness of these lights. The -skyscale argument affects brightness of entity sun lights." [
    // -------- Q3MAP2 KEYS --------
    light(float) : "Light Intensity" : "300" : "Overrides the default 300 intensity. Negative values may be used for negative lights."
    _color(color1) : "Light Color" : "1 1 1" : "Weighted RGB value of light color (default 1.0 1.0 1.0 = white)."
    target(target_destination) : "Target" : : "Lights pointed at a target will be spotlights."
    radius(float) : "Spotlight Radius" : "64" : "Overrides the default 64 unit radius of a spotlight at the target point."
    _sun(boolean) : "Sun" : : "Set this key to 1 on a spotlight to make an infinite sun light."
    fade(float) : "Linear Fade" : "1" : "Fades light attenuation. Only affects linear lights."
    scale(float) : "Intensity Scale" : "1" : "Scales light attenuation, from SOF2/JK2. Scales the `light` value."
    _deviance(float) : "Penumbra Deviance" : "0" : "Penumbra effect - distance measured in world units for point/spot lights, and degrees for suns (~0.5-3)."
    _samples(float) : "Penumbra Samples" : "1" : "Penumbra effect - the number of random jitters distributed over the solid arc (~16)."
    _filter(boolean) : "Lightmap Filtering" : : "Set this key to 1 to toggle on lightmap filtering."
    _filterradius(float) : "Filter Radius" : : "Filters lightmaps within set radius."
    _anglescale(float) : "Light Attenuation Scale" : "1" : "Scales light attenuation. Smaller values lessens angle attenuation, larger values for sharper, more faceted lighting (default 1.0)."
    style(integer) : "Light Style Index" : : "Light style index number associated with worldspawn light style. Values are between 1 and 31."

    spawnflags(flags) = [
        1 : "Linear Falloff" : 0 : "Use a linear falloff. Default is inverse distance squared (more realistic)."
        2 : "No Angle Attenuation" : 0 : "Ignore angle attenuation."
        16 : "Not Dynamic" : 0 : "Do not affect the lightgrid (dynamic entity lighting)."
    ]
]

@PointClass color(0 0.7 0.3) size(-6 -6 -6, 6 6 6) = lightJunior : "Non-displayed point light source THAT ONLY AFFECTS ENTITIES (lightgrid). The -pointscale and -scale arguments to Q3Map2 affect the brightness of these lights. The -skyscale argument affects brightness of entity sun lights." [
    // -------- Q3MAP2 KEYS --------
    _light(float) : "Light Intensity" : "300" : "Overrides the default 300 intensity. Negative values may be used for negative lights."
    _color(color1) : "Light Color" : "1 1 1" : "Weighted RGB value of light color (default 1.0 1.0 1.0 = white)."
    target(target_destination) : "Target" : : "Lights pointed at a target will be spotlights."
    radius(float) : "Spotlight Radius" : "64" : "Overrides the default 64 unit radius of a spotlight at the target point."
    _sun(boolean) : "Sun" : : "Set this key to 1 on a spotlight to make an infinite sun light."
    fade(float) : "Linear Fade" : "1" : "Fades light attenuation. Only affects linear lights."
    scale(float) : "Intensity Scale" : "1" : "Scales light attenuation, from SOF2/JK2. Scales the `light` value."

    spawnflags(flags) = [
        1 : "Linear Falloff" : 0 : "Use a linear falloff. Default is inverse distance squared (more realistic)."
        2 : "No Angle Attenuation" : 0 : "Ignore angle attenuation."
        16 : "Not Dynamic" : 0 : "Do not affect the lightgrid (dynamic entity lighting)."
    ]
]



//
// MISC_* ENTITIES
//

@PointClass color(.8 .6 .3) size(-16 -16 -16, 16 16 16) model({"path": model}) = misc_model : "Generic placeholder for inserting MD3 models in game. Requires compilation of map geometry to be added to level. If the map is compiled with Q3Map2, then ASE, 3DS, OBJ and other model formats are supported." [
    // -------- Q3MAP2 KEYS --------
    model(string) : "Model File" : : "Path/name of model to use (e.g. models/mapobjects/teleporter/teleporter.md3)."
    angle(float) : "Yaw Angle" : : "Direction in which model will be oriented."
    angles(vector) : "Pitch Yaw Roll" : "0 0 0" : "Individual control of PITCH, YAW, and ROLL (default 0 0 0)."
    modelscale(float) : "Uniform Scale" : "1" : "Floating-point value used to scale a model up or down (default 1.0)."
    modelscale_vec(float) : "Scale XYZ" : "1 1 1" : "Floating-point vector used to scale a model's axes individually (default 1.0 1.0 1.0)."
    _remap(array) : "Shader Remaps" : : "Used to remap textures/shaders in the model. To remap all shaders to a given shader, use `*;models/mymodel/mytexture`. To remap a specific shader, use `models/mymodel/old;models/mymodel/new`."
    target(target_destination) : "Target" : : "Used to attach the misc_model to a brush entity, where its `targetname` key is the same value."
    _lightmapscale(float) : "Lightmap Scale" : "1" : "Floating point value scales the resolution of lightmaps on this model (if model is using lightmapped shaders) (default 1.0)."
    _castshadows(integer) : "Shadow Caster Level" : 1 : "Allows per-entity control over shadow casting. Defaults to 0 on entities, 1 on world. 0 = no shadow casting. 1 = cast shadows on world. &gt; 1 = cast shadows on entities with _rs (or _receiveshadows) with the corresponding value, AND world. Negative values imply same, but DO NOT cast shadows on world."
    _receiveshadows(integer) : "Shadow Reciever Level" : 1 : "Allows per-entity control over shadow reception. Defaults to 1 on everything (world shadows). 0 = receives NO shadows. &gt; 1 = receive shadows only from corresponding keyed entities (see above) and world. &lt; 1 = receive shadows ONLY from corresponding keyed entities."
    _celshader(texture) : "Cel Shader" : : "Sets the cel shader used for this geometry. Note: Omit the `textures/` prefix."
    _clipdepth(float) : "Autoclip thickness" : "2" : "Autoclip brushes thickness (default 2.0)."

    spawnflags(flags) = [
        1 : "_RMG_BSP" : 0 : "in SoF2, append a _RMG_BSP suffix to shader names instead of _BSP"
        2 : "Clip Model" : 0 : "Clips the model for player/weapon collisions; extruding every face along most perpendicular axial direction. For use on large architectural or terrain models, not for small decorative models."
        4 : "Force Meta" : 0 : "Toggles on q3map_forceMeta for lightmapped models. Converts model triangles to bsp metasurfaces."
        8 : "EXTRUDE_FACE_NORMALS" : 0 : "extrude along the model face normals for clipping"
        16 : "EXTRUDE_TERRAIN" : 0 : "extrude each surface of the model along its average axial direction ( up/down/west/east/north/south ); faces with not matching direction (or too steep) are clipped in default mode"
        32 : "COLOR_TO_ALPHA" : 0 : "use the color value as alpha (for terrain blending)"
        64 : "NOSMOOTH" : 0 : "Don't smooth normals when importing (forces all faces planar)."
        128 : "EXTRUDE_VERTEX_NORMALS" : 0 : "extrude along the model vertex normals for clipping; accurate collisions, if normals are fine; bad ones are replaced with 45 degrees to face"
        256 : "PYRAMIDAL_CLIP" : 0 : "pyramidal clipping brushes (4-sided); accurate collisions"
        512 : "EXTRUDE_DOWNWARDS" : 0 : "for horizontal terrain; when not possible, extrude in default mode"
        1024 : "EXTRUDE_UPWARDS" : 0 : "-//-"
        2048 : "MAX_EXTRUDE" : 0 : "Extrude to the max/min point of every model surface to reduce bsp size (uses axial back plane)"
        4096 : "AXIAL_BACKPLANE" : 0 : "use axial back plane for clipping brushes to effectively reduce bsp size; might cause unwanted collisions, make sure to -debugclip; negative _clipdepth / -clipdepth limits max thickness of resulting brushes (making non-axial backplane, if hit the limit)"
    ]

    //other possible modes of clipping:
    //CLIPMODEL+AXIAL_BACKPLANE
    //EXTRUDE_FACE_NORMALS+PYRAMIDAL_CLIP - truncated pyramid with 45 degrees sides
    //EXTRUDE_TERRAIN+MAX_EXTRUDE
    //EXTRUDE_TERRAIN+AXIAL_BACKPLANE
    //EXTRUDE_VERTEX_NORMALS + PYRAMIDAL_CLIP - vertex normals mode: don't check for sides, sticking outwards
    //PYRAMIDAL_CLIP+AXIAL_BACKPLANE - pyramid with 3 of 4 sides axial (->small bsp)
    //EXTRUDE_DOWNWARDS+EXTRUDE_UPWARDS
    //EXTRUDE_DOWNWARDS+MAX_EXTRUDE
    //EXTRUDE_DOWNWARDS+AXIAL_BACKPLANE
    //EXTRUDE_DOWNWARDS+EXTRUDE_UPWARDS+MAX_EXTRUDE
    //EXTRUDE_DOWNWARDS+EXTRUDE_UPWARDS+AXIAL_BACKPLANE
    //EXTRUDE_UPWARDS+MAX_EXTRUDE
    //EXTRUDE_UPWARDS+AXIAL_BACKPLANE
]

@PointClass base(Target, TargetName) color(1 .5 .25) size(-16 -16 -16, 16 16 16) model(model) = model_destruct : "Explodes in a shower of gibs when damaged." [
    model(string) : "Model File" : : "Path/name of model to use (e.g. models/mapobjects/teleporter/teleporter.md3)."
    health(float) : "Health" : "10" : "Health of the model."
    gibcount(float) : "Gib Count" : "4" : "Amount of gibs (default 4)."
    bouncefactor(float) : "Bounce" : "0.25" : "Bounciness of debris (default 0.25)."
    particlename(string) : "Particles" : : "Name of particles (found in effectinfo.txt)"
    startnonsolid(boolean) : "Starts Non Solid" : "0" : "Set to 1 and brush will be non solid the first second (useful for node graph)."
    mass(float) : "Mass" : "0.75" : "Weight of debris (default 0.75)."
    noise(string) : "Sound Effect" : "sound/impact/destruct/" : ""
    base_scale(float) : "Gib Scale" : "1" : "Scales size of gibs. `-1` is no scaling applied."
    type(choices) : "Material Type" : 0 = [
        0 : "Custom (enables custom debris models)"
        1 : "Stone"
        2 : "Wood"
        3 : "Metal"
        4 : "Glass"
        5 : "Ice"
    ]
    gibmodel1(string) : "Debris Model A" : "models/destruct/" : "Custom derbis model A"
    gibmodel2(string) : "Debris Model B" : "models/destruct/" : "Custom derbis model B"
    gibmodel3(string) : "Debris Model V" : "models/destruct/" : "Custom derbis model C"
    rad_sound(float) : "Sound Radius" : "256" : "Radius of destruction sounds."
    volume(float) : "Sound Volume" : "1" : "Volume of destruction sounds."
    spread_vel(float) : "Spread Factor" : "0" : "Spread Factor."
    only_damage_monster(boolean) : "Monster Damage" : "0" : "Can be destroyed only by monsters."
    touch_smash(choices) : "Touch Destruction" : 0 = [
        0 : "No Touch Destruction"
        1 : "Can be destroyed if touched by Player"
        2 : "Can be destroyed if touched by Monsters"
        3 : "Can be destroyed if touched by Player and Monsters"
    ]
    touch_smash_delay(float) : "Touch Destruction Delay" : "0" : "(delay before be destroyed if touch destruction is enabled)"
]

@PointClass color(1 .5 .25) size(-16 -16 -16, 16 16 16) model({"Path": model}) = place_model : "Generic placeholder for inserting MD3 models in game. Doesnt Requires compilation of map geometry to be added to level." [
