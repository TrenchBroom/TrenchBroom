    scale(float) : "Uniform Scale" : "1" : "Floating-point value used to scale a model up or down (default 1.0)."
]

@PointClass color(.7 .7 .7) size(-16 -16 -24, 16 16 32) model("models/enemies/shepherd/shepherd.md3") = place_shepherd : "The Shepherd of Wayward Souls. For INTRO and HUB map appearances." [
