@BaseClass = TargetName [
    targetname(target_source) : "Name"
]
@BaseClass = Target [
    target(target_destination) : "Target" : "All entities with a matching targetname will be triggered."
]

// Q3MAP2 ENTITIES

@SolidClass = _decal : "Compiler-only entity that specifies a decal to be projected. Should contain 1 or more patch meshes (curves) and target an info_null entity. Patch mesh should be using a shader with 'polygonoffset' (or other blending methods) or z-fighting will occur. The distance between the center of the _decal entity and the target is the axis and distance of projection."
[
    target(target_destination) : "Target" : "The name of the entity targeted for projection."
]

@PointClass size(-4 -4 -4, 4 4 4) color(0.77 0.88 1.0) = _skybox : "Compiler-only entity that specifies the origin of a skybox (a wholly contained, separate area of the map), similar to some games portal skies. When compiled with Q3Map2, the skybox surfaces will be visible from any place where sky is normally visible. It will cast shadows on the normal parts of the map, and can be used with cloud layers and other effects."
[
    angle(float) : "Angle" : "0" : "Rotation angle of the sky surfaces."
    angles(vector) : "pitch roll yaw" : "0 0 0" : "Individual control of PITCH, YAW, and ROLL (default 0 0 0)."
    _scale(float) : "Scale" : "64" : "Scaling factor (default 64), good values are between 50 and 300, depending on the map."
]

// SOUND ENTITIES

@PointClass color(0 1 0.2) size(-16 -16 -16, 16 16 16) = soundbox : "Sound Box" [
    rad_sound(integer) : "Sounds Radius" : 512
    volume(integer) : "Volume" : 1
    noise(string) : "Noise" : "sound/doors/e1m2_pillar.ogg" : "Sound file to play"
    delay(float) : "Delay" : "-1"
    minpitch(float) : "Minimum Pitch" : "0.1"
    spawnflags(flags) = [
        1 : "Attenuation 0"
        2 : "Force Loop"
        32 : "No Spatialize" : 0 : "2D sound only"
    ]
]

@PointClass color(0 1 0) size(-16 -16 -16, 16 16 16) = randomsoundbox : "Random Sound Box" [
    spawnflags(flags) =
    [
        32 : "No Spatialize" : 0 : "2D sound only"
    ]
    noise1(string)
    noise2(string)
    noise3(string)
    noise4(string)
    noise5(string)
    noise6(string)
    noise7(string)
    noise8(string)
    noise9(string)
    noise10(string)
    noise11(string)
    noise12(string)
    noise13(string)
    noise14(string)
    noise15(string)
    rad_sound(float) : "Sound Radius" : "512"
    rad_sound_inner(float) : : "0" : "inner sound box with no attenuation, default 0"
    volume(float) : "Volume" : "1"
    mindelay(float) : "Minimum Delay"
    maxdelay(float) : "Maximum Delay"
]

