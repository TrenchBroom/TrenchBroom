//
// FUNC_* ENTITIES
//

@SolidClass base(TargetName) color(0 0.5 0.8) = func_bobbing : "Solid entity that oscillates back and forth in a linear motion. By default, it will have an amount of displacement in either direction equal to the dimension of the brush in the axis in which it's bobbing. Entity bobs on the Z axis (up-down) by default. It can also emit sound if the `noise` key is set. Will crush the player when blocked." [
    speed(float) : "Bob Cycle Time" : "16" : "amount of time in seconds for one complete oscillation cycle."
    height(integer) : "Vertical Travel" : 32 : "sets the amount of travel of the oscillation movement (default 32)."
    phase(float) : "Bob Cycle Phase" : "0" : "sets the start offset of the oscillation cycle. Values must be 0 &lt; phase &lt; 1. Any integer phase value is the same as no offset (default 0)."
    noise(string) : "Sound File" : : "path/name of .wav file to play. Use looping sounds only (eg. sound/world/drone6.wav - See Notes)."
    model2(string) : "Model File" : : "path/name of model to include (eg: models/mapobjects/jets/jets01.md3)."
    origin(vector) : "World Origin" : : "alternate method of setting XYZ origin of sound and .md3 model included with entity (See Notes)."
    light(float) : "Model Light Intensity" : "0" : "constantLight radius of .md3 model included with entity. Has no effect on the entity's brushes (default 0)."
    color(vector) : "Model Light Color" : "1 1 1" : "constantLight color of .md3 model included with entity. Has no effect on the entity's brushes (default 1 1 1)."
    //-------- Q3MAP2 KEYS --------
    _lightmapscale(float) : "Lightmap Scale" : "1.0" : "Floating point value scaling the resolution of lightmaps on brushes/patches in this entity (default 1.0)."
    _castshadows(integer) : "Shadow Caster Level" : 0 : "Allows per-entity control over shadow casting. Defaults to 0 on entities, 1 on world. 0 = no shadow casting. 1 = cast shadows on world. > 1 = cast shadows on entities with _rs (or _receiveshadows) with the corresponding value, AND world. Negative values imply same, but DO NOT cast shadows on world."
    _receiveshadows(integer) : "Shadow Reciever Level" : 1 : "Allows per-entity control over shadow reception. Defaults to 1 on everything (world shadows). 0 = receives NO shadows. > 1 = receive shadows only from corresponding keyed entities (see above) and world. &lt; 1 = receive shadows ONLY from corresponding keyed entities."
    _celshader(string) : "Cel Shader" : : "Sets the cel shader used for this geometry. Note: omit the `textures/` prefix."
    //-------- SPAWNFLAGS --------
    spawnflags(flags) = [
        1 : "X Axis" : 0 : "entity will bob along the X axis."
        2 : "Y Axis" : 0 : "entity will bob along the Y axis."
    ]
    //-------- NOTES --------
    //In order for the sound to be emitted from the entity, it is recommended to include a brush with an origin shader at its center, otherwise the sound will not follow the entity as it moves. Setting the origin key is simply an alternate method to using an origin brush. When using the model2 key, the origin point of the model will correspond to the origin point defined by either the origin brush or the origin coordinate value.
    //
    //Target this entity with a misc_model to have the model attached to the entity (set the model's "target" key to the same value as this entity's "targetname").
]

@SolidClass = func_bob : "Moves back and forth between the two targets" [
    speed(float) : "Bob Cycle Time" : "512" : "amount of time in seconds for one complete oscillation cycle."
    count(float) : "Count" : "2" : "Easing factor"
    distancetotarget(float) : "Distance to Target" : "128"
    target(target_destination) : "Target 1"
    target2(target_destination) : "Target 2"
]

// FIXME the using property doesn't work and the QuakeC code always sets particle emitters to start active
@SolidClass base(TargetName) color(.4 .4 .4) = func_particles : "Particles Emitter, use an invisible brush to determine the area of spawning"
[
    particlename(string) : "Particle effect Name" : "proj_heretic_impact" : "which particle name will use, located in effectinfo.txt"
    delay(float) : "Delay time" : "0.5" : "Delay time between each particle spawning"
    density(integer) : "Density ammount" : 1 : "multiply of ammount of particles."
    count(integer) : "ammount of particles" : 1 : "amount of particles(default is based on size of brush)."
    using(integer) : "Start Active" : 1 : "The emitter will start emiting particles, if 0, targetname is required."
    clipdist(integer) : "Clip Distance" : 512 : "Distance at which particles will no longer be shown."
]

@PointClass base(TargetName) color(.4 .4 .4) size(-8 -8 -8, 8 8 8) = model_emitter : "Particles Emitter, use an invisible point to determine the origin of spawning" [
    using(integer) : "Start Active" : 1 : "The emitter will start emiting particles, if 0, targetname is required."
    spawnflags(flags) = [
        1 : "Start Active" : 0 : "The emitter will start emiting particles"
    ]

    model1(string) : "Spawned Model A" : "particles/" : "Spawned model A"
    model2(string) : "Spawned Model B" : "particles/" : "Spawned model B"
    model3(string) : "Spawned Model C" : "particles/" : "Spawned model C"
    model4(string) : "Spawned Model D" : "particles/" : "Spawned model D"
    model5(string) : "Spawned Model E" : "particles/" : "Spawned model E"
    model6(string) : "Spawned Model F" : "particles/" : "Spawned model F"
    model7(string) : "Spawned Model G" : "particles/" : "Spawned model G"
    model8(string) : "Spawned Model H" : "particles/" : "Spawned model H"

    noise1(string) : "Noise 1"
    noise2(string) : "Noise 2"
    noise3(string) : "Noise 3"

    delay(float) : "Delay time" : "0.5" : "Delay time between each model spawning"
    gravity(float) : "Gravity" : "-0.1" : "Gravity of model (default normal gravity: 1)."
    loop(integer) : "Looped" : 1 : "Is the use continous? -1 no, 1 YES"
    speed(float) : "Speed" : "16" : "default speed of the models."
    count(integer) : "Amount of Particles" : 1 : "amount of particles model in each spawn."
    min_time(float) : "Min Time Life" : "1" : "min time life before fade."
    max_time(float) : "Max Time Life" : "1" : "max time life before fade."
    min_size(float) : "Min Scale Size" : "1" : "min scale value."
    max_size(float) : "Max Scale Size" : "1" : "max scale value."
    clipdist(integer) : "Clip Distance" : 512 : "Distance at which particles will no longer be shown. Default 512 units."
    valpha(vector) : "Alpha  Values" : "0 1 1" : "alpha (min_alpha max_alpha fade_rate)."
    originoffset(vector) : "Origin Offset" : "0 0 0" : "Offset particle spawning origin by this values. Coordspace are world, x – forward, y – right, z – up."
    originjitter(vector) : "Origin Jitter" : "0 0 0" : "Like originoffset but each axis is jittered between -value/+value. Hence it is defining spherical shape of particle random spawning."
    velocityoffset(vector) : "Velocity Offset" : "0 0 0" : "Add this amount of constant velocity to particle on spawn."
    velocityjitter(vector) : "Velocity Jitter" : "0 0 0" : "Like velocity offset but each axis is jittered between -value/+value. Hence it is defining spherical shape of particle random spawning."
    particle_movetype(choices) : "Movetype" : 8 = [
        0 : "NONE"
        6 : "TOSS"
        8 : "NOCLIP"
        9 : "FLYMISSILE"
        10 : "BOUNCE"
        11 : "BOUNCEMISSILE"
    ]
    particle_modelflags(choices) : "Modelflags" : 0 = [
        1 : "ROCKET"
        2 : "GRENADE"
        4 : "GIB"
        8 : "ROTATE"
        16 : "GREEN"
        32 : "ZOMGIB"
        64 : "ORANGE"
        128 : "PURPLE"
    ]
    particlename(string) : "Trail Effect Name" : "" : "which trail effect model will use if present, located in effectinfo.txt"
]

@SolidClass base(TargetName) color(.4 .4 .4) = func_weather : "Particles Emitter, use an invisible brush to determine the area of spawning" [
    type(choices) : "Type of weather particle" : 1 = [
        1 : "Snow"
        2 : "Rain"
    ]
    delay(float) : "Delay time" : "0.1" : "Delay time between each particle spawning"
    density(integer) : "Density ammount" : 1 : "amount of particle density(default is 1)."
    using(integer) : "Start Active" : 1 : "The emitter will start emiting particles, if 0, targetname is required."
]

@SolidClass color(0 .5 .8) = func_illusionary : "A simple entity that looks solid but lets you walk through it. Does not block light." [
    targetname(target_source) : "Target Name" : "" : "If set, a func_button or trigger is required to toggle the visibility of the func_illusionary."
    spawnflags(flags) = [
        1 : "Start invisible" : 0 : "When set, the brush will spawn invisible."
    ]
]

@SolidClass color(0 .5 .8) = func_brush : "A simple entity that looks solid but lets you walk through it. Does not block light." []

@SolidClass base(TargetName) color(0 .5 .8) = func_fan : "A simple entity that rotates." [
rot_ang_x(float) : "Rotate X" : "0" : "rotate speed for angle X"
rot_ang_y(float) : "Rotate Y" : "0" : "rotate speed for angle Y"
rot_ang_z(float) : "Rotate Z" : "0" : "rotate speed for angle Z"

    spawnflags(flags) = [
        1 : "Start OFF" : 0 : "When set, the fan will spawn rotating."
    ]
]

@SolidClass color(0 .5 .8) = func_wall : "This is just a solid wall if not inhibitted." [
    displacemente(integer) : "Displacement Wall" : 0 : "Set to 1 and brush will be non solid and invisible until a trigger_displacement is used."
]

@SolidClass color(0 .4 1) = func_water : "Liquids volume entity" [
    alpha(float) : "Alpha" : "0.75" : "Transparency of water."
    colormod(color1) : "Color" : ".5 .5 .5" : "Water surface color, normalized RGB values (0-1, 0-1, 0-1).  Example of blue: .3 .45 .6"
    cshift(string) : "Underwater Color" : "64 64 64 128" : "Underwater color, RGB Alpha.  Example of blue: 16 32 48 128"
    watertype(choices) : "Type of liquid" : "-3" = [
        -3 : "Water"
        -4 : "Slime"
        -5 : "Lava"
    ]
    targetname(target_source) : "Target Name" : "" : "If set, a func_button or trigger is required to move the water as a door."
    lip(integer) : "Lip" : 0 : "Lip remaining at end of move. Default value is 0"
    speed(float) : "Move Speed" : "100" : "Determines how fast the water moves (default is 100)."
    deep(integer) : "deep water" : 0 : "set to 1 if water is placed underwater to prevent physics bugs(default 0)."
    _lightmapscale(float) : "Lightmap Scale" : "1" : "Floating point value scales the resolution of lightmaps on brushes/patches in this entity (default 1.0)."
    spawnflags(flags) = [
        1 : "Start Moved" : 0 : "The water will spawn in the final pos and operate in reverse."
    ]
    height_water1(float) : "Height1" : "0" : "Height at which the entity will raise to upon being targeted. Each impulse will raise the entity by X units, until reaching the apex. Cannot be reset. Default value is 0"
    height_water2(float) : "Height2" : "0" : "Height at which the entity will raise to upon being targeted. Each impulse will raise the entity by X units, until reaching the apex. Cannot be reset. Default value is 0"
    height_water3(float) : "Height3" : "0" : "Height at which the entity will raise to upon being targeted. Each impulse will raise the entity by X units, until reaching the apex. Cannot be reset. Default value is 0"
]

@SolidClass base(Target) color(0 .4 1) = func_button : "When a button is touched by a player, it moves in the direction set by the `angle` key, triggers all its targets, stays pressed by an amount of time set by the `wait` key, then returns to it's original position where it can be operated again." [
    angle(float) : "Direction" : "0" : "Determines the direction in which the button will move (up = -1, down = -2)."
    targetname(target_source) : "Target Name" : "" : "If set, other entities can be used to activate the button along with touch or damage way of doing that."
    speed(float) : "Move Speed" : "40" : "Speed of button's displacement (default 40)."
    wait(float) : "Return Delay" : "1" : "Number of seconds button stays pressed (default 1, -1 = no return)."
    lip(float) : "Lip" : "0" : "Lip remaining at end of move. Default value is 0."
    buttondecal(integer) : "Decal Button" : 0 : "Set to 1 to add extra volume if the brush is a decal."
]

// FIXME must have more properties
@SolidClass base(Target, TargetName) color(0 .4 1) = func_door : "Normal sliding door entity. By default, the door will activate when player walks close to it or when damage is inflicted to it." [
    angle(float) : "Direction" : "0" : "Determines the opening direction of door (up = -1, down = -2)."
    keyrequired(choices) : "Key Required" : 0 : "Key need to open" = [
        0 : "Unlocked"
        1 : "Red key"
        2 : "Blue key required"
        3 : "Yellow key required"
    ]
    notouch(integer) : "No Touch" : 0 : "Set to 1 so player can't activate by `use`, such as when the door is targeted by another entity like a trigger or button."
    fake_lighted(integer) : "Fake Lightning" : 0 : "Set to 1 and brush will use fake lightning."
    startnonsolid(integer) : "Starts Non Solid" : 0 : "Set to 1 and brush will be non solid the first second (useful for node graph)."
    speed(float) : "Move Speed" : "200" : "Determines how fast the door moves (default is around 200)."
    wait(float) : "Return Delay" : "2" : "Number of seconds before door returns (default 2, -1 = never return)"
    lip(float) : "Lip" : "0" : "Lip remaining at end of move. Default value is 0"
    dmg(integer) : "Damage Inflicted" : 4 : "Damage to inflict on player when he blocks operation of door (default 4)."
    _lightmapscale(float) : "Lightmap Scale" : "1" : "Floating point value scaling the resolution of lightmaps on brushes/patches in this entity (default 1.0)."
    spawnflags(flags) = [
        1 : "Start Open" : 0 : "The door will spawn in the open state and operate in reverse."
    ]
    attached_model(string) : "Attached Model" : "" : "name of the model attached to the door"
]

@SolidClass color(0 .4375 .7) = func_group : "This is not an entity as such. It is strictly an editor utility to group world brushes and patches together for convenience (selecting, moving, copying, etc). You cannot group entities with this." [
    //-------- Q3MAP2 KEYS --------
    _lightmapscale(float) : "Lightmap Scale" : "1" : "Floating point value scales the resolution of lightmaps on brushes/patches in this entity (default 1.0)."
    _castshadows(integer) : "Shadow Caster Level" : 1 : "Allows per-entity control over shadow casting. Defaults to 0 on entities, 1 on world. 0 = no shadow casting. 1 = cast shadows on world. &gt; 1 = cast shadows on entities with _rs (or _receiveshadows) with the corresponding value, AND world. Negative values imply same, but DO NOT cast shadows on world."
    _receiveshadows(integer) : "Shadow Reciever Level" : 1 : "Allows per-entity control over shadow reception. Defaults to 1 on everything (world shadows). 0 = receives NO shadows. &gt; 1 = receive shadows only from corresponding keyed entities (see above) and world. &lt; 1 = receive shadows ONLY from corresponding keyed entities."
    _celshader(texture) : "Cel Shader" : "" : "Sets the cel shader used for this geometry. Note: Omit the `textures/` prefix."
    //-------- Q3MAP2 TERRAIN KEYS --------
    _indexmap(texture) : "Terrain Blending Map" : "" : "Path/name for the art file used to guide the mapping of textures on the terrain surface."
    _layers(integer) : "Terrain Layers" : : "Integer value denotes number of unique root shaders that will be used on the terrain."
    _shader(texture) : "Terrain MetaShader" : : "Path to the metashader used to assign textures to the terrain entity. Note: Omit the `textures/` prefix."
    //-------- NOTES --------
    //To make a func_group into a terrain entity, refer to the Terrain Construction documentation.
]

@SolidClass color(0 .4 1) = func_plat : "Rising platform the player can ride to reach higher places. Plats must always be drawn in the raised position, so they will operate and be lighted correctly but they spawn in the lowered position. The plat will stay in the raised position until the player steps off. There are no proper sounds for this entity, only beep noises. It will spawn in the game and work properly but it sounds silly (see notes)." [
    speed(float) : "Move Speed" : "150" : "Determines how fast the plat moves (default 150)."
    lip(float) : "Lip" : "16" : "Lip remaining at end of move (default 16). Has no effect if `height` is set."
    height(float) : "Vertical Travel" : : "If set, this will determine the total amount of vertical travel of the plat."
    dmg(integer) : "Damage Inflicted" : 4 : "Damage to inflict on player when he blocks operation of plat (default 4). Plat will reverse direction when blocked."
    noise(string) : "start sound 1" : "" : "sound to play"
    noise1(string) : "working sound 2" : "" : "sound to play"
    noise2(string) : "stop sound 3" : "" : "sound to play"
    rad_sound(float) : "Sound Radius" : "256" : "Radius of sounds."
    volume(float) : "Sound Volume" : "1" : "Volume of sounds."
    targetname(target_source) : "Target Name" : "" : "If set, the trigger that points to this will raise the plat each time it fires. The plat raises and comes back down a second later if no player is on it."
    _lightmapscale(float) : "Lightmap Scale" : "1" : "Floating point value scales the resolution of lightmaps on brushes/patches in this entity (default 1.0)."
]

@SolidClass base(Target) color(0 .4 1) = func_destruct : "brush entity then can be destroyed by player" [
    health(float) : "Health" : "10" : "Health of the func."
    min_damage(float) : "Minimun damage needed to destroy in a single hit" : "0" : "Minimum damage needed in a single hit."
    gibcount(float) : "Gib Count" : "4" : "Amount of gibs (default 4)."
    bouncefactor(float) : "Bounce" : "0.25" : "Bounciness of debris (default 0.25)."
    particlename(string) : "Particles" : "" : "Name of particles (found in effectinfo.txt)"
    startnonsolid(integer) : "Starts Non Solid" : 0 : "Set to 1 and brush will be non solid the first second (useful for node graph)."
    mass(float) : "Mass" : "0.75" : "Weight of debris (default 0.75)."
    noise(string) : "Sound Effect" : "sound/impact/destruct/" : ""
    base_scale(float) : "Gib Scale" : "1" : "Scales size of gibs. `-1` is no scaling applied."
    type(choices) : "Material Type" : 0 = [
        0 : "Custom (enables custom debris models)"
        1 : "Stone"
        2 : "Wood"
        3 : "Metal"
        4 : "Glass"
        5 : "Ice"
    ]
    gibmodel1(string) : "Debris Model A" : "models/destruct/" : "Custom derbis model A"
    gibmodel2(string) : "Debris Model B" : "models/destruct/" : "Custom derbis model B"
    gibmodel3(string) : "Debris Model V" : "models/destruct/" : "Custom derbis model C"
    rad_sound(float) : "Sound Radius" : "256" : "Radius of destruction sounds."
    volume(float) : "Sound Volume" : "1" : "Volume of destruction sounds."
    spread_vel(float) : "Spread Factor" : "0" : "Spread Factor."
    only_damage_monster(float) : "Monster Damage" : "0" : "Can be destroyed only by monsters."
    touch_smash(choices) : "Touch Destruction" : 0 = [
        0 : "No Touch Destruction"
        1 : "Can be destroyed if touched by Player"
        2 : "Can be destroyed if touched by Monsters"
        3 : "Can be destroyed if touched by Player and Monsters"
    ]
    touch_smash_delay(float) : "Touch Destruction Delay" : "0" : "(delay before be destroyed if touch destruction is enabled)"
    // -------- Q3MAP2 KEYS --------
    targetname(target_source) : "Target Name" : "" : "Used to attach a misc_model entity to this entity."
    _lightmapscale(float) : "Lightmap Scale" : "1" : "Floating point value scales the resolution of lightmaps on brushes/patches in this entity (default 1.0)."
    _castshadows(integer) : "Shadow Caster Level" : 0 : "Allows per-entity control over shadow casting. Defaults to 0 on entities, 1 on world. 0 = no shadow casting. 1 = cast shadows on world. &gt; 1 = cast shadows on entities with _rs (or _receiveshadows) with the corresponding value, AND world. Negative values imply same, but DO NOT cast shadows on world."
    _receiveshadows(integer) : "Shadow Reciever Level" : 1 : "Allows per-entity control over shadow reception. Defaults to 1 on everything (world shadows). 0 = receives NO shadows. &gt; 1 = receive shadows only from corresponding keyed entities (see above) and world. &lt; 1 = receive shadows ONLY from corresponding keyed entities."
]

